# --- Moveworks instance ---
# Base URL for your data center. See:
# https://docs.moveworks.com/api-reference/overview#base-urls
MW_BASE_URL=https://api.moveworks.ai

# Bot Name of the Conversations API chatbot you created in Moveworks Setup
# (sent as the Assistant-Name header).
MW_BOT_NAME=

# Your Moveworks instance's Admin Portal domain, used to fetch the JWKS for webhook signature
# verification (https://{org}.moveworks.com/.well-known/jwks.json).
MW_ORG_DOMAIN=

# --- Self-signed JWT (S2S) ---
# Issuer and Audience: the values you configured on the credential in the
# Moveworks Admin Portal. Must match exactly.
MW_S2S_ISSUER=
MW_S2S_AUDIENCE=
# Key ID (kid) returned by Moveworks when you registered your public key.
MW_S2S_KEY_ID=
# Path to the RSA private key (PEM) whose public counterpart you registered.
MW_S2S_PRIVATE_KEY_PATH=./keys/private_key.pem
# Email address of the roster user to act on behalf of. The signed assertion
# uses this as the `sub` claim.
MW_S2S_USER_EMAIL=

# --- Okta interactive (OIDC + PKCE) ---
# Your Okta Custom Authorization Server issuer:
#   https://{yourOktaDomain}/oauth2/{authServerId}
# The Okta setup guide recommends a Custom Authorization Server over the
# built-in Org Authorization Server.
MW_OKTA_ISSUER=
# Client ID of the Okta OIDC app configured for Moveworks integration.
MW_OKTA_CLIENT_ID=
# One of the Sign-in redirect URIs registered on the Okta app. The starter
# code binds a local server on the port in this URL.
MW_OKTA_REDIRECT_URI=http://127.0.0.1:8765/callback
# OAuth scopes to request. Must include 'openid' and whatever custom scope
# the Moveworks credential expects. 'openid profile email' is the common default.
MW_OKTA_SCOPES=openid profile email

# --- Entra ID interactive (OIDC + PKCE) ---
# Directory (tenant) ID. The issuer is derived from it:
#   https://login.microsoftonline.com/{tenant_id}/v2.0
MW_ENTRA_TENANT_ID=
# Application (client) ID of the app registration.
MW_ENTRA_CLIENT_ID=
# Loopback redirect URI registered under "Mobile and desktop applications",
# with "Allow public client flows" set to Yes. The port is bound locally.
MW_ENTRA_REDIRECT_URI=http://127.0.0.1:8765/callback
# Scopes. Never a Microsoft Graph scope; Graph tokens cannot be validated by
# Moveworks. Leave empty for "{MW_ENTRA_CLIENT_ID}/.default", the scope the
# setup guide uses.
MW_ENTRA_SCOPES=

# --- HTTP Connector API Key ---
# Long-lived opaque key minted in Moveworks Admin Portal → HTTP Connectors → Credentials.
# Bound to the roster user who created it; every call runs as that user.
MW_API_KEY=

# --- Auth path selection ---
# Used by check_setup.py and poll_events.py: s2s | okta | entra | api-key
# (get_idp_token.py takes okta | entra.)
# (The reference web app asks in the browser: an API key, or the S2S values above.)
MW_AUTH=s2s

# --- Polling example ---
# When using MW_AUTH=okta, entra, or api-key, set the user identifier the
# checkpoint should be keyed against. For MW_AUTH=s2s this is derived from
# MW_S2S_USER_EMAIL and does not need to be set.
MW_POLL_USER_ID=
# Where to persist the per-user last_event_id checkpoint.
CHECKPOINT_PATH=./checkpoints/checkpoint.json
# Interval between polls, in seconds.
POLL_INTERVAL_SECONDS=15

# --- Webhook receiver example ---
# Host and port to bind the FastAPI receiver on. Put the receiver behind your
# HTTPS reverse proxy or tunnel; set 0.0.0.0 only when the proxy needs it.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
# Max clock skew between webhook-timestamp and receiver in seconds.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Proactive notification trigger example ---
# Used by examples/trigger_listener.py. An Agent Studio listener URL whose
# compound action sends a proactive notification to the user you are testing
# as. See the trigger_listener section of examples/README.md.
MW_TEST_LISTENER_URL=
# HMAC secret, when the listener verifies signatures (lifts the unsecured
# listener rate limit).
MW_TEST_LISTENER_SECRET=
# Recipient for test notifications: the user your credential acts as.
# Defaults to MW_S2S_USER_EMAIL when unset.
MW_TEST_NOTIFY_EMAIL=
